{
  "name": "ngx-input-mask-workspace",
  "version": "3.0.0",
  "description": "Input mask directive for angular",
  "scripts": {
    "test": "ng test",
    "prebuild": "npm install && rimraf dist/",
    "build": "ng build ngx-input-mask",
    "release": "npm run build && npm publish --access public ./dist",
    "tsc": "tsc --noemit",
    "format": "prettier --write 'projects/**/*.ts'",
    "lint": "eslint 'projects/**/*.ts' --fix --max-warnings=0",
    "tfl": "npm run tsc && npm run format && npm run lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~22.2.3",
    "@angular/common": "~22.2.3",
    "@angular/compiler": "~22.2.3",
    "@angular/core": "~22.2.3",
    "@angular/forms": "~22.2.3",
    "@angular/platform-browser": "~22.2.3",
    "@angular/platform-browser-dynamic": "~22.2.3",
    "@angular/router": "~22.2.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "~22.2.4",
    "@angular/cli": "~22.2.4",
    "@angular/compiler-cli": "~22.2.3",
    "@evojs/eslint-plugin": "~8.1.0",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "~8.72.1",
    "@typescript-eslint/parser": "~8.72.1",
    "eslint": "~9.39.5",

    "jasmine-core": "~6.3.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "ng-packagr": "~22.2.5",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aristocr2t/ngx-input-mask.git"
  },
  "bugs": {
    "url": "https://github.com/aristocr2t/ngx-input-mask/issues"
  },
  "homepage": "https://github.com/aristocr2t/ngx-input-mask#readme"
}
